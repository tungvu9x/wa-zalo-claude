# Dia chi Cloud (khong dung path prefix, dung subdomain)
CLOUD_URL=https://wa.example.com
# Lay tu POST /admin/devices
DEVICE_ID=
DEVICE_SECRET=

# Thu muc luu session, outbox, file cho den khi upload xong
DATA_DIR=./data

ENABLE_WHATSAPP=true
ENABLE_ZALO=true

# File lon hon muc nay chi ghi nhan metadata, khong upload
MAX_FILE_MB=100

# Tuy chon: dung Chrome da cai san thay vi Chromium cua puppeteer
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
